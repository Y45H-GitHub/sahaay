# =============================================================================
# SAHAAY BACKEND CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your actual values
# Never commit the .env file to version control

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# Port for the Express server to listen on
PORT=3001
# Environment mode (development, production, test)
NODE_ENV=development

# =============================================================================
# MURF.AI FALCON TTS API
# =============================================================================
# Get your API key from: https://murf.ai/
# Required for text-to-speech functionality
MURF_API_KEY=your_murf_api_key_here
# Murf API base URL (usually doesn't need to change)
MURF_API_URL=https://api.murf.ai/v1

# =============================================================================
# OPENAI API CONFIGURATION
# =============================================================================
# Get your API key from: https://platform.openai.com/
# Required for scene description and general Q&A
OPENAI_API_KEY=your_openai_api_key_here
# Model to use for text generation (gpt-4, gpt-3.5-turbo, etc.)
OPENAI_MODEL=gpt-4
# Maximum tokens for OpenAI responses
OPENAI_MAX_TOKENS=500
# Temperature for response creativity (0.0-1.0)
OPENAI_TEMPERATURE=0.7

# =============================================================================
# GOOGLE CLOUD VISION API (OPTIONAL)
# =============================================================================
# Alternative OCR service - can be used instead of Tesseract.js
# Get your API key from: https://cloud.google.com/vision/
GOOGLE_CLOUD_VISION_API_KEY=your_google_cloud_vision_api_key_here

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# URL of the frontend application for CORS policy
# Change this to your production frontend URL when deploying
FRONTEND_URL=http://localhost:5173

# =============================================================================
# EMERGENCY NOTIFICATION CONFIGURATION
# =============================================================================
# Webhook URL to call when emergency is triggered
# This could be a service like Zapier, IFTTT, or custom endpoint
EMERGENCY_WEBHOOK_URL=your_emergency_webhook_url_here
# Emergency contact phone number (for SMS notifications)
EMERGENCY_PHONE_NUMBER=your_emergency_contact_number_here

# =============================================================================
# OPTIONAL: ADDITIONAL CONFIGURATION
# =============================================================================
# Maximum file size for image uploads (in bytes)
# MAX_FILE_SIZE=5242880
# Request timeout in milliseconds
# REQUEST_TIMEOUT=30000
# Enable debug logging
# DEBUG=true
