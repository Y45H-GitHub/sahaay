# =============================================================================
# SAHAAY FRONTEND CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your actual values
# Never commit the .env file to version control

# =============================================================================
# BACKEND API CONFIGURATION
# =============================================================================
# Base URL for the backend API
# Change this to your production backend URL when deploying
VITE_API_BASE_URL=http://localhost:3001

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Application name displayed in the UI
VITE_APP_NAME=Sahaay
# Default language for the application (en, hi, hinglish)
VITE_DEFAULT_LANGUAGE=en

# =============================================================================
# OPTIONAL: ADDITIONAL CONFIGURATION
# =============================================================================
# Enable debug mode for additional console logging
# VITE_DEBUG=true
# Maximum audio recording duration in seconds
# VITE_MAX_RECORDING_DURATION=30
# Camera resolution preference (low, medium, high)
# VITE_CAMERA_QUALITY=medium
